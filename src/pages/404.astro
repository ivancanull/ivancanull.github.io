---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found on Huifan Zhang's research portfolio."
  robots="noindex, nofollow"
>
  <section class="page-container page-intro" aria-labelledby="not-found-heading">
    <p class="eyebrow">Error 404</p>
    <h1 id="not-found-heading">Page not found</h1>
    <p>The page you requested may have moved or no longer exists.</p>
    <p><a class="section-link" href="/">Return home</a></p>
  </section>
</BaseLayout>
