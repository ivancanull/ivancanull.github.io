---
interface Props {
  title: string;
  index: number;
}

const { title, index } = Astro.props;
const headingId = title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
const sectionNumber = String(index).padStart(2, "0");
---

<section class="cv-section" aria-labelledby={headingId}>
  <h2 id={headingId}><span aria-hidden="true">{sectionNumber}</span>{title}</h2>
  <div class="cv-section__body">
    <slot />
  </div>
</section>
